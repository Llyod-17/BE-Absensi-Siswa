DB_HOST = 127.0.0.1
DB_NAME = absensi_siswa_db
DB_PORT = 3306
PORT = ":3000"

JWT_SECRET = UOTYDHJSS

# Nomor WA untuk pairing code (format: 628xxxxxxxxxx, tanpa + atau spasi)
WA_PHONE = 628xxxxxxxxxx

# Data cleanup otomatis (03:00 WIB) — berapa hari data ke belakang yang dipertahankan
CLEANUP_ATTENDANCE_DAYS = 240
CLEANUP_NOTIFICATION_DAYS = 90
CLEANUP_ADMIN_NOTIF_DAYS = 90

# Jadwal cron notifikasi WA harian (format: menit jam hari bulan hari_minggu, zona Asia/Jakarta)
# Default: 30 8 * * * = setiap hari jam 08:30 WIB
WA_SEND_CRON = 30 8 * * *